<Window Style="{StaticResource {x:Type Window}}" x:Class="KBSetup.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Installation de KB Account Manager" Width="620" Height="560" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Icon="/icon.ico">
    <Grid Margin="34,30,34,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ============ En-tête ============ -->
        <StackPanel Orientation="Horizontal">
            <Border Width="64" Height="64" CornerRadius="16" ClipToBounds="True" Background="#00020F"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                <Image Source="/logo.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
            <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Text="Installer KB Account Manager" Style="{StaticResource H1}"/>
                <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" Margin="0,3,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- ============ Page 1 : options ============ -->
        <StackPanel x:Name="PageOptions" Grid.Row="1" Margin="0,24,0,0">
            <TextBlock Text="Dossier d'installation" FontWeight="Medium"/>
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="DirBox" FontFamily="Consolas" FontSize="12"/>
                <Button Grid.Column="1" Content="Parcourir…" Margin="8,0,0,0" Click="OnBrowse"/>
            </Grid>
            <TextBlock x:Name="DirHint" Style="{StaticResource Caption}" Margin="0,6,0,0"
                       Text="Installation pour toi seul : aucun droit administrateur nécessaire."/>

            <TextBlock Text="Options" FontWeight="Medium" Margin="0,22,0,0"/>
            <CheckBox x:Name="DesktopBox" Content="Créer un raccourci sur le Bureau" IsChecked="True" Margin="0,12,0,0"/>
            <CheckBox x:Name="MenuBox" Content="Ajouter au menu Démarrer" IsChecked="True" Margin="0,12,0,0"/>
            <CheckBox x:Name="AutoStartBox" Content="Démarrer avec Windows (réduit dans la barre système)" Margin="0,12,0,0"/>

            <Border x:Name="RunningWarn" Visibility="Collapsed" Margin="0,22,0,0" Padding="14,10" CornerRadius="10"
                    Background="#22FFB84D" BorderBrush="#44FFB84D" BorderThickness="1">
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource WarnBrush}"
                           Text="KB Account Manager est ouvert. Quitte-le (icône de la barre système > Quitter) avant de continuer. Tes Roblox ouverts ne sont pas fermés."/>
            </Border>
            <TextBlock x:Name="ErrText" Foreground="{StaticResource BadBrush}" TextWrapping="Wrap" Margin="0,16,0,0" Visibility="Collapsed"/>
        </StackPanel>

        <!-- ============ Page 2 : progression ============ -->
        <StackPanel x:Name="PageProgress" Grid.Row="1" Margin="0,70,0,0" Visibility="Collapsed">
            <TextBlock x:Name="ProgText" Text="Installation en cours…" Style="{StaticResource H2}"/>
            <ProgressBar x:Name="Bar" Maximum="100" Height="8" Margin="0,16,0,0"/>
            <TextBlock x:Name="ProgDetail" Style="{StaticResource Caption}" Margin="0,10,0,0"/>
        </StackPanel>

        <!-- ============ Page 3 : terminé ============ -->
        <StackPanel x:Name="PageDone" Grid.Row="1" Margin="0,50,0,0" Visibility="Collapsed">
            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="46" Foreground="{StaticResource GoodBrush}"/>
            <TextBlock x:Name="DoneTitle" Text="KB Account Manager est installé" Style="{StaticResource H1}" Margin="0,12,0,0"/>
            <TextBlock x:Name="DoneText" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,8,0,0"/>
            <CheckBox x:Name="LaunchBox" Content="Lancer KB Account Manager" IsChecked="True" Margin="0,24,0,0"/>
            <TextBlock Style="{StaticResource Caption}" Margin="0,18,0,0"
                       Text="Pour le désinstaller : Paramètres Windows &gt; Applications &gt; Applications installées &gt; KB Account Manager."/>
        </StackPanel>

        <!-- ============ Boutons ============ -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelBtn" Content="Annuler" Margin="0,0,10,0" Padding="20,9" Click="OnCancel"/>
            <Button x:Name="InstallBtn" Content="Installer" Style="{StaticResource PrimaryButton}" Padding="28,9" Click="OnInstall"/>
        </StackPanel>
    </Grid>
</Window>
