<UserControl x:Class="BBManager.Views.InstancesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="IconBtn" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="26,22,26,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Instances" Style="{StaticResource H1}"/>
                <TextBlock x:Name="Summary" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Ranger les fenêtres" Margin="0,0,8,0" Click="OnTile"
                        ToolTip="Dispose toutes les fenêtres Roblox en grille (réglages dans Paramètres &gt; Lancement)"/>
                <Button Content="Libérer la RAM" Margin="0,0,8,0" Click="OnTrim"
                        ToolTip="Vide immédiatement le working set de chaque instance (la RAM revient au système, les pages utiles sont rechargées à la demande)"/>
                <Button Content="Appliquer les limites" Margin="0,0,8,0" Click="OnApply"
                        ToolTip="Ré-applique priorité, cœurs et limite RAM à toutes les instances"/>
                <Button Content="Tout fermer" Style="{StaticResource DangerButton}" Click="OnCloseAll"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,16,0,14" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="SysText" FontWeight="SemiBold"/>
                    <ProgressBar x:Name="SysBar" Margin="0,8,0,0" Maximum="1" Height="6"/>
                </StackPanel>
                <Button Grid.Column="1" Content="Fermer tous les Roblox (même hors appli)" Style="{StaticResource GhostButton}"
                        Margin="18,0,0,0" VerticalAlignment="Center" Click="OnKillAllRoblox"
                        ToolTip="Termine tous les RobloxPlayerBeta.exe, y compris ceux lancés sans l'appli. Utile avant d'activer le multi-instance."/>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <ListBox x:Name="List" Style="{StaticResource PlainList}" SelectionMode="Extended" Padding="0,0,6,0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="14,11" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="46"/>
                                <ColumnDefinition Width="*" MinWidth="150"/>
                                <ColumnDefinition Width="*" MinWidth="200"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid Width="42" Height="42" HorizontalAlignment="Left">
                                <Ellipse Fill="{StaticResource Bg4Brush}"/>
                                <Ellipse><Ellipse.Fill><ImageBrush ImageSource="{Binding AvatarUrl}" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse>
                            </Grid>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,10,0">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock Style="{StaticResource Caption}" TextWrapping="NoWrap">
                                    <Run Text="PID"/> <Run Text="{Binding Pid, Mode=OneWay}"/> <Run Text="·"/> <Run Text="{Binding UptimeText, Mode=OneWay}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding AfkText}" Style="{StaticResource Caption}" TextWrapping="NoWrap"
                                           Visibility="{Binding AfkText, Converter={StaticResource StringVisible}}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                <Grid>
                                    <TextBlock Text="{Binding RamText}" FontWeight="Medium"/>
                                    <TextBlock Text="{Binding RamLimitMb, Converter={StaticResource RamLimitText}, StringFormat='limite : {0}'}"
                                               Style="{StaticResource Caption}" HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar Value="{Binding RamRatio}" Maximum="1" Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding CommitText}" Style="{StaticResource Caption}" Margin="0,4,0,0"
                                           ToolTip="Mémoire que le jeu a réservée. Limiter la RAM réduit la mémoire physique utilisée, pas cette valeur."/>
                            </StackPanel>

                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                <TextBlock Text="Limite RAM (Mo)" Style="{StaticResource Caption}" Margin="2,0,0,3"/>
                                <TextBox Text="{Binding RamLimitMb, UpdateSourceTrigger=LostFocus}" Padding="8,4" LostFocus="OnLimitChanged" KeyDown="OnLimitKey"
                                         ToolTip="0 = utiliser la limite globale. Appliqué dès que tu quittes le champ (ou Entrée)."/>
                            </StackPanel>

                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                <Button Style="{StaticResource IconBtn}" Content="&#xE8A7;" ToolTip="Mettre au premier plan" Click="OnFocus"/>
                                <Button Style="{StaticResource IconBtn}" Content="&#xE72C;" ToolTip="Relancer" Click="OnRelaunch"/>
                                <Button Style="{StaticResource IconBtn}" Content="&#xE711;" ToolTip="Fermer" Click="OnClose" Foreground="{StaticResource BadBrush}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7F4;" FontSize="44" Foreground="{StaticResource FaintBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Aucune instance en cours" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                <TextBlock Text="Lance des comptes depuis l'onglet Comptes : ils apparaîtront ici avec leur RAM en direct." Style="{StaticResource Dim}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
