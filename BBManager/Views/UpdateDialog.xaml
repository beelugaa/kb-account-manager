<Window Style="{StaticResource {x:Type Window}}" x:Class="BBManager.Views.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mise à jour" Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource Bg1Brush}">
    <StackPanel Margin="28,26,28,22">
        <StackPanel Orientation="Horizontal">
            <Border Width="48" Height="48" CornerRadius="12" ClipToBounds="True" Background="#00020F" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                <Image Source="/Assets/logo.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Style="{StaticResource H1}" Text="Mise à jour disponible"/>
                <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <TextBlock x:Name="NotesTitle" Text="Nouveautés" FontWeight="Medium" Margin="0,18,0,6"/>
        <Border Style="{StaticResource Card}" Padding="14,10" MaxHeight="160">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="NotesText" TextWrapping="Wrap" Style="{StaticResource Dim}" LineHeight="20"/>
            </ScrollViewer>
        </Border>
        <TextBlock x:Name="InfoText" Style="{StaticResource Caption}" Margin="0,12,0,0"
                   Text="L'appli va se fermer puis se rouvrir toute seule. Tes Roblox ouverts ne sont pas fermés et seront reconnus au redémarrage. Tes comptes sont conservés."/>

        <ProgressBar x:Name="Bar" Maximum="100" Height="6" Margin="0,16,0,0" Visibility="Collapsed"/>
        <TextBlock x:Name="ErrText" Foreground="{StaticResource BadBrush}" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="LaterBtn" Content="Plus tard" Margin="0,0,10,0" Padding="18,8" Click="OnLater"/>
            <Button x:Name="InstallBtn" Content="Installer maintenant" Style="{StaticResource PrimaryButton}" Padding="20,8" Click="OnInstall"/>
        </StackPanel>
    </StackPanel>
</Window>
