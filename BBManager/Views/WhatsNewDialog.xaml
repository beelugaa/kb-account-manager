<Window Style="{StaticResource {x:Type Window}}" x:Class="BBManager.Views.WhatsNewDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nouveautés" Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource Bg1Brush}">
    <StackPanel Margin="28,26,28,22">
        <StackPanel Orientation="Horizontal">
            <Border Width="48" Height="48" CornerRadius="12" ClipToBounds="True" Background="#00020F" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                <Image Source="/Assets/logo.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Style="{StaticResource H1}" Text="Nouveautés"/>
                <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" Margin="0,2,0,0"/>
            </StackPanel>
        </StackPanel>

        <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,18,0,0" MaxHeight="260">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="Items"/>
            </ScrollViewer>
        </Border>

        <Button x:Name="OkBtn" Content="Compris" Style="{StaticResource PrimaryButton}" Padding="24,8"
                HorizontalAlignment="Right" Margin="0,20,0,0" IsDefault="True" IsCancel="True" Click="OnOk"
                AutomationProperties.Name="Compris"/>
    </StackPanel>
</Window>
