<Window Style="{StaticResource {x:Type Window}}" x:Class="BBManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KB Account Manager" Icon="/Assets/icon.ico" Width="1220" Height="780" MinWidth="1000" MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Barre latérale ============ -->
        <Border Background="{StaticResource Bg1Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="14,20,14,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="6,0,0,22">
                    <Border Width="40" Height="40" CornerRadius="10" ClipToBounds="True" Background="#00020F"
                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                        <Image Source="/Assets/logo.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="KB Manager" FontWeight="SemiBold" FontSize="15"/>
                        <TextBlock Text="Account Manager" Style="{StaticResource Caption}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="NavAccounts" Style="{StaticResource NavButton}" IsChecked="True" Checked="OnNav" Tag="accounts">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE716;" FontSize="16" Width="26" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="Comptes" FontWeight="Medium" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavProfiles" Style="{StaticResource NavButton}" Checked="OnNav" Tag="profiles">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8FD;" FontSize="16" Width="26" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="Profils" FontWeight="Medium" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavInstances" Style="{StaticResource NavButton}" Checked="OnNav" Tag="instances">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE7F4;" FontSize="16" Width="26" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                <TextBlock Text="Instances" FontWeight="Medium" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" Style="{StaticResource Chip}" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding RunningCount}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                            </Border>
                        </Grid>
                    </RadioButton>
                    <RadioButton x:Name="NavAfk" Style="{StaticResource NavButton}" Checked="OnNav" Tag="afk">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE823;" FontSize="16" Width="26" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="Anti-AFK" FontWeight="Medium" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" Checked="OnNav" Tag="settings">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE713;" FontSize="16" Width="26" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="Paramètres" FontWeight="Medium" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <StackPanel Grid.Row="3">
                    <Border x:Name="UpdateCard" Style="{StaticResource Card}" Padding="14,12" Margin="0,0,0,10" Visibility="Collapsed"
                            Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}" Cursor="Hand"
                            MouseLeftButtonUp="OnUpdateCardClick">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE896;" Foreground="{DynamicResource AccentBrush}" Margin="0,1,8,0"/>
                                <TextBlock Text="Mise à jour disponible" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock x:Name="UpdateCardText" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                            <TextBlock Text="Clique pour installer" Style="{StaticResource Caption}" Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                    </Border>
                <Border Style="{StaticResource Card}" Padding="14,12" Background="{StaticResource Bg2Brush}">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Multi-instance" FontWeight="SemiBold"/>
                            <Ellipse x:Name="MultiDot" Width="9" Height="9" HorizontalAlignment="Right" Fill="{StaticResource FaintBrush}"/>
                        </Grid>
                        <TextBlock x:Name="MultiText" Style="{StaticResource Caption}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Contenu ============ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <ContentControl x:Name="AccountsHost"/>
                <ContentControl x:Name="ProfilesHost" Visibility="Collapsed"/>
                <ContentControl x:Name="InstancesHost" Visibility="Collapsed"/>
                <ContentControl x:Name="AfkHost" Visibility="Collapsed"/>
                <ContentControl x:Name="SettingsHost" Visibility="Collapsed"/>
            </Grid>

            <Border Grid.Row="1" Background="{StaticResource Bg1Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="22,9">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Text="{Binding StatusMessage}" Style="{StaticResource Dim}"/>
                    <TextBlock Grid.Column="1" Text="{Binding StatsText}" Style="{StaticResource Dim}" Margin="20,0,0,0"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ============ Écran de verrouillage ============ -->
        <Grid x:Name="LockLayer" Grid.ColumnSpan="2" Background="{StaticResource Bg0Brush}" Visibility="Collapsed" Panel.ZIndex="100">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="330">
                <Border Width="72" Height="72" CornerRadius="18" ClipToBounds="True" Background="#00020F" BorderBrush="{StaticResource LineBrush}"
                        BorderThickness="1" HorizontalAlignment="Center">
                    <Image Source="/Assets/logo.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <TextBlock Text="KB Manager est verrouillé" Style="{StaticResource H1}" HorizontalAlignment="Center" Margin="0,18,0,4"/>
                <TextBlock Text="Entre ton mot de passe pour continuer." Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,0,0,18"/>
                <PasswordBox x:Name="LockPwd" KeyDown="OnLockKey"/>
                <TextBlock x:Name="LockErr" Foreground="{StaticResource BadBrush}" Margin="0,10,0,0" TextWrapping="Wrap"
                           Visibility="Collapsed" HorizontalAlignment="Center" TextAlignment="Center"/>
                <Button x:Name="LockBtn" Content="Déverrouiller" Style="{StaticResource PrimaryButton}" Margin="0,16,0,0" Padding="20,9" Click="OnLockUnlock"/>
                <Button Content="J'ai oublié mon mot de passe" Style="{StaticResource GhostButton}" HorizontalAlignment="Center" Margin="0,8,0,0" Click="OnLockForgot"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
