<Window Style="{StaticResource {x:Type Window}}" x:Class="BBManager.Views.BulkEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modifier la sélection" Width="600" Height="720" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource Bg1Brush}">
    <Grid Margin="28,24,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="TitleText" Style="{StaticResource H1}"/>
            <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                       Text="Active seulement ce que tu veux changer : les réglages laissés désactivés ne sont pas touchés."/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0" Padding="0,0,10,0">
            <StackPanel>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <CheckBox x:Name="GroupCheck" Content="Groupe" VerticalAlignment="Center"/>
                    <ComboBox x:Name="GroupBox" Grid.Column="1" DisplayMemberPath="Name" IsEnabled="{Binding IsChecked, ElementName=GroupCheck}"/>
                </Grid>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <CheckBox x:Name="PlaceCheck" Content="Place ID par défaut" VerticalAlignment="Center"/>
                    <TextBox x:Name="PlaceBox" Grid.Column="1" IsEnabled="{Binding IsChecked, ElementName=PlaceCheck}" ToolTip="Vide = retirer le jeu par défaut"/>
                </Grid>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <CheckBox x:Name="RamCheck" Content="Limite de RAM (Mo)" VerticalAlignment="Center"/>
                    <TextBox x:Name="RamBox" Grid.Column="1" IsEnabled="{Binding IsChecked, ElementName=RamCheck}" ToolTip="0 = limite globale"/>
                </Grid>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <CheckBox x:Name="KeepCheck" Content="Relancer automatiquement" VerticalAlignment="Center"/>
                    <ComboBox x:Name="KeepBox" Grid.Column="1" IsEnabled="{Binding IsChecked, ElementName=KeepCheck}"/>
                </Grid>

                <Separator Margin="0,0,0,14"/>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <CheckBox x:Name="AfkCheck" Content="Anti-AFK" VerticalAlignment="Center"/>
                    <ComboBox x:Name="AfkBox" Grid.Column="1" IsEnabled="{Binding IsChecked, ElementName=AfkCheck}"/>
                </Grid>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <CheckBox x:Name="MethodCheck" Content="Méthode AFK" VerticalAlignment="Center"/>
                    <ComboBox x:Name="MethodBox" Grid.Column="1" IsEnabled="{Binding IsChecked, ElementName=MethodCheck}"/>
                </Grid>
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <CheckBox x:Name="IntervalCheck" Content="Intervalle AFK (s)" VerticalAlignment="Center"/>
                    <TextBox x:Name="IntervalBox" Grid.Column="1" IsEnabled="{Binding IsChecked, ElementName=IntervalCheck}" ToolTip="0 = intervalle par défaut, sinon 15 s minimum"/>
                </Grid>

                <Separator Margin="0,0,0,14"/>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <CheckBox x:Name="AliasCheck" Content="Alias (nom affiché)" VerticalAlignment="Center"/>
                    <TextBox x:Name="AliasBox" Grid.Column="1" IsEnabled="{Binding IsChecked, ElementName=AliasCheck}" MaxLength="100"/>
                </Grid>
                <TextBlock Style="{StaticResource Caption}" Margin="212,0,0,14"
                           Text="Modèle : {n} = numéro (1, 2, 3…), {nom} = pseudo Roblox. Exemple : « Farm {n} ». Vide = effacer l'alias."/>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <CheckBox x:Name="NotesCheck" Content="Notes" VerticalAlignment="Top" Margin="0,8,0,0"/>
                    <StackPanel Grid.Column="1" IsEnabled="{Binding IsChecked, ElementName=NotesCheck}">
                        <ComboBox x:Name="NotesMode" Margin="0,0,0,8"/>
                        <TextBox x:Name="NotesBox" Height="64" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" MaxLength="2000"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock x:Name="ErrText" Foreground="{StaticResource BadBrush}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Annuler" Margin="0,0,10,0" Click="OnCancel"/>
                <Button x:Name="ApplyBtn" Content="Appliquer" Style="{StaticResource PrimaryButton}" Padding="22,8" Click="OnApply"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
