<Window Style="{StaticResource {x:Type Window}}" x:Class="BBManager.Views.GroupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Groupe" Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource Bg1Brush}">
    <StackPanel Margin="26,24,26,22">
        <TextBlock x:Name="TitleText" Style="{StaticResource H2}" FontSize="16" Text="Nouveau groupe"/>
        <TextBlock Text="Nom" Style="{StaticResource Caption}" Margin="0,16,0,5"/>
        <TextBox x:Name="NameBox" KeyDown="OnKey"/>
        <TextBlock Text="Couleur" Style="{StaticResource Caption}" Margin="0,14,0,6"/>
        <WrapPanel x:Name="Swatches"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Annuler" Margin="0,0,8,0" Click="OnCancel"/>
            <Button Content="Enregistrer" Style="{StaticResource PrimaryButton}" Click="OnOk"/>
        </StackPanel>
    </StackPanel>
</Window>
