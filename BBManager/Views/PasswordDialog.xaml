<Window Style="{StaticResource {x:Type Window}}" x:Class="BBManager.Views.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KB Manager" Width="420" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg1Brush}">
    <StackPanel Margin="28,26,28,22">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Border Width="40" Height="40" CornerRadius="10" ClipToBounds="True" Background="#00020F" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                <Image Source="/Assets/logo.png" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
            </Border>
            <TextBlock x:Name="TitleText" Style="{StaticResource H1}" Text="Déverrouiller" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>
        <TextBlock x:Name="SubText" Style="{StaticResource Caption}" Margin="0,0,0,14"
                   Text="Tes comptes sont protégés par un mot de passe."/>
        <PasswordBox x:Name="Pwd1" KeyDown="OnKey" PasswordChanged="OnPwdChanged"/>
        <PasswordBox x:Name="Pwd2" Margin="0,10,0,0" Visibility="Collapsed" KeyDown="OnKey"/>
        <TextBlock x:Name="Strength" Style="{StaticResource Caption}" Margin="2,8,0,0" Visibility="Collapsed"/>
        <TextBlock x:Name="Err" Foreground="{StaticResource BadBrush}" Margin="0,10,0,0" Visibility="Collapsed" TextWrapping="Wrap"/>
        <Button x:Name="ForgotBtn" Content="J'ai oublié mon mot de passe" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                Margin="-8,10,0,0" Click="OnForgot" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelBtn" Content="Annuler" Margin="0,0,8,0" Click="OnCancel"/>
            <Button x:Name="OkBtn" Content="Déverrouiller" Style="{StaticResource PrimaryButton}" Click="OnOk" Padding="20,7"/>
        </StackPanel>
    </StackPanel>
</Window>
