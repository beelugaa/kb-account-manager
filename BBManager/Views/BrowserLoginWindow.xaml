<Window Style="{StaticResource {x:Type Window}}" x:Class="BBManager.Views.BrowserLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Connexion à Roblox" Width="560" Height="760"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Bg1Brush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Padding="18,12" Background="{StaticResource Bg2Brush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="Connecte-toi au compte à ajouter" FontWeight="SemiBold"/>
                <TextBlock x:Name="Hint" Style="{StaticResource Caption}" Margin="0,3,0,0"
                           Text="Session vierge : aucun compte n'est déjà connecté ici. La fenêtre se fermera toute seule une fois connecté."/>
            </StackPanel>
        </Border>
        <wv2:WebView2 x:Name="Web" Grid.Row="1"/>
    </Grid>
</Window>
