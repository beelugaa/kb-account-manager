<Window Style="{StaticResource {x:Type Window}}" x:Class="BBManager.Views.ForgotPasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mot de passe oublié" Width="470" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource Bg1Brush}">
    <StackPanel Margin="28,26,28,22">
        <TextBlock Text="Mot de passe oublié" Style="{StaticResource H1}"/>
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource DimBrush}" LineHeight="20" Margin="0,12,0,0">
            Ton mot de passe ne peut pas être récupéré : il sert de clé pour chiffrer tes cookies, et personne ne l'a, pas même moi.
        </TextBlock>
        <Border Margin="0,14,0,0" Padding="14,12" CornerRadius="10" Background="#22FF5C7A" BorderBrush="#44FF5C7A" BorderThickness="1">
            <TextBlock TextWrapping="Wrap" LineHeight="20">
                <Run FontWeight="SemiBold">Réinitialiser l'appli</Run> supprime définitivement tous les comptes, groupes, jeux et réglages
                enregistrés. Tes comptes Roblox ne sont pas touchés : tu pourras les ajouter à nouveau.
            </TextBlock>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="NoBtn" Content="Non, retour" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Padding="20,8" IsDefault="True" Click="OnNo"/>
            <Button Content="Réinitialiser l'appli" Style="{StaticResource DangerButton}" Padding="16,8" Click="OnReset"/>
        </StackPanel>
    </StackPanel>
</Window>
