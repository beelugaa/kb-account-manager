<UserControl x:Class="BBManager.Views.ProfilesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style x:Key="IconBtn" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="26,22,26,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Profils de lancement" Style="{StaticResource H1}"/>
                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                           Text="Un profil = des comptes + un jeu + des options. Lance-le en un clic, ou programme-le à heure fixe."/>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Click="OnNew" VerticalAlignment="Center" AutomationProperties.Name="Nouveau profil">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE710;" Foreground="White" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Nouveau profil" Foreground="White"/>
                </StackPanel>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <ListBox x:Name="List" Style="{StaticResource PlainList}" SelectionMode="Single" Padding="0,0,6,0" MouseDoubleClick="OnDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="16,14" Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15"/>
                                <TextBlock Text="{Binding AccountsText}" Style="{StaticResource Dim}" Margin="0,4,0,0" TextWrapping="NoWrap"/>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <Border Style="{StaticResource Chip}" Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE768;" FontSize="10" Margin="0,1,6,0" VerticalAlignment="Center" Foreground="{StaticResource DimBrush}"/>
                                            <TextBlock Text="{Binding GameText}" FontSize="11.5" MaxWidth="300"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource Chip}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE823;" FontSize="10" Margin="0,1,6,0" VerticalAlignment="Center" Foreground="{StaticResource DimBrush}"/>
                                            <TextBlock Text="{Binding ScheduleText}" FontSize="11.5"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Lancer" Style="{StaticResource PrimaryButton}" Padding="18,8" Margin="0,0,6,0" Click="OnLaunch"/>
                                <Button Style="{StaticResource IconBtn}" Content="&#xE70F;" ToolTip="Modifier" Click="OnEdit"/>
                                <Button Style="{StaticResource IconBtn}" Content="&#xE8C8;" ToolTip="Dupliquer" Click="OnDuplicate"/>
                                <Button Style="{StaticResource IconBtn}" Content="&#xE74D;" ToolTip="Supprimer" Click="OnDelete" Foreground="{StaticResource BadBrush}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8FD;" FontSize="44" Foreground="{StaticResource FaintBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Aucun profil pour l'instant" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                <TextBlock Style="{StaticResource Dim}" HorizontalAlignment="Center" TextAlignment="Center"
                           Text="Clique sur « Nouveau profil », ou sélectionne des comptes dans l'onglet Comptes puis « + Profil »."/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
